{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "**/*.icc",
        "watchAssets": true },
      { "include": "**/*.ttf",
        "watchAssets": true },
      { "include": "**/*.png",
        "watchAssets": true },
      {
        "include": "certificates/*",
        "outDir": "dist"
      }
    ]
  }
}
