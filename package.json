{
  "name": "signature-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env OPENSSL_CONF=./openssl-sat-legacy.cnf NODE_OPTIONS=--openssl-shared-config nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env OPENSSL_CONF=./openssl-sat-legacy.cnf NODE_OPTIONS=--openssl-shared-config node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:documents": "ts-node -r tsconfig-paths/register src/scripts/seed-documents.ts",
    "seed:roles": "ts-node -r tsconfig-paths/register src/scripts/seed-roles.ts",
    "seed:billing-catalog": "ts-node -r tsconfig-paths/register src/scripts/seed-billing-catalog.ts",
    "seed:documents:prod": "node dist/scripts/seed-documents.js",
    "seed:roles:prod": "node dist/scripts/seed-roles.js",
    "seed:billing-catalog:prod": "node dist/scripts/seed-billing-catalog.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@otplib/preset-default": "^12.0.1",
    "@sendgrid/mail": "^8.1.6",
    "@types/multer": "^2.1.0",
    "@types/qrcode": "^1.5.6",
    "asn1js": "^3.0.10",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "easy-ocsp": "^1.3.2",
    "ioredis": "^5.10.1",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.3",
    "mongodb": "^6.21.0",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1",
    "otplib": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.2.20",
    "pg": "^8.20.0",
    "pkijs": "^3.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "stripe": "^22.3.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.3.1",
    "@types/pdfmake": "^0.2.13",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "i": "^0.3.7",
    "jest": "^29.7.0",
    "jsqr": "^1.4.0",
    "npm": "^11.13.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
