# Database Configuration
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME provision the postgres container
# in docker-compose.yml (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB). The app
# itself does NOT read these individually — it reads POSTGRES_DB_URL below.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=signature_db
# docker-compose.yml maps the postgres container to host port 5434 (see
# "ports: 5434:5432" on the postgres service) — use that host port here when
# running the app on the host against the dockerized database.
POSTGRES_DB_URL=postgresql://postgres:postgres@localhost:5434/signature_db

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL for password reset links / CORS origin
FRONTEND_URL=http://localhost:3001

# Mongo
# MONGO_USERNAME/MONGO_PASSWORD/MONGO_DB_NAME provision the mongo container in
# docker-compose.yml. The app reads the full connection string MONGO_DB_URL.
MONGO_USERNAME=admin
MONGO_PASSWORD=admin_password
MONGO_DB_NAME=mongo_db
# docker-compose.yml maps the mongo container to host port 27018 (see
# "ports: 27018:27017" on the mongo service).
MONGO_DB_URL=mongodb://admin:admin_password@localhost:27018/mongo_db?authSource=admin

# Minio Conection Configuration
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY are the credentials the app authenticates
# to MinIO with — they must match MINIO_ROOT_USER/MINIO_ROOT_PASSWORD below
# (or a non-root access key you create in the MinIO console), otherwise every
# file operation (document/signature uploads) fails with an auth error even
# though the container itself starts fine.
MINIO_HOST=localhost
MINIO_PORT=9010
# MINIO_PUBLIC_HOST/MINIO_PUBLIC_PORT configure the "public" client (the one that signs the
# presigned URLs the browser fetches directly, see MinioService.getMinioPublicClient) — required
# since the private/public client split; without them MinioService throws on startup. In local
# dev they point at the same docker-compose MinIO as MINIO_HOST/MINIO_PORT above.
MINIO_PUBLIC_HOST=localhost
MINIO_PUBLIC_PORT=9010
# The local docker-compose MinIO speaks plain HTTP, not HTTPS, so the public client (the one
# that signs URLs the browser fetches directly) needs useSSL off locally — otherwise the
# browser gets ERR_SSL_PROTOCOL_ERROR trying to load the presigned URL over https://. In
# production this stays true/unset because MINIO_PUBLIC_HOST sits behind a TLS-terminating
# proxy there.
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio_pass
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_pass

MINIO_CREATED_DOCUMENTS_BUCKET=created-documents
MINIO_SIGNED_DOCUMENTS_BUCKET=signed-documents
# Versión definitiva que ve y descarga el usuario: el documento firmado con la hoja de información
# de firmas anexada (ver historia "Anexar hoja existente de información de firmas al documento
# final"). Va en un bucket propio para que en signed-documents quede intacto el documento firmado
# sin la hoja, que es el insumo con el que se calculó su signedHash.
# OJO: el bucket debe existir en MinIO antes de firmar — este proyecto no los crea solo.
MINIO_FINALIZED_DOCUMENTS_BUCKET=finalized-documents
# Vista previa del documento con las firmas registradas hasta ahora, mientras todavía faltan
# firmantes (historia "Actualizar el previsualizador con el avance de firmas"). Copia desechable:
# se regenera desde el original en cada firma y deja de usarse cuando el documento queda firmado.
MINIO_PARTIALLY_SIGNED_DOCUMENTS_BUCKET=partially-signed-documents
MINIO_CANCELLED_DOCUMENTS_BUCKET=cancelled-documents
MINIO_REJECTED_DOCUMENTS_BUCKET=rejected-documents
MINIO_OFICIAL_CARDS_BUCKET=oficial-id-cards
MINIO_SIGNATURE_IMAGES_BUCKET=signature-images


CIPHER_SECRET='tu-clave-de-cifrado-reversible'

# JWT auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h

# Redis
# Required by docker-compose.yml (redis service's port mapping and
# --requirepass) — without these two, `docker compose up redis` fails.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-redis-password

# Kafka
# docker-compose.yml runs Kafka in KRaft mode with two listeners: PLAINTEXT
# (internal, used by other containers on the compose network — e.g. "kafka:9092")
# and EXTERNAL (mapped to host port 9094, see "ports: 9094:9094" on the kafka
# service). The app runs on the host during local dev (npm run start:dev), so
# it connects through the EXTERNAL listener below, same as POSTGRES_DB_URL
# and MONGO_DB_URL connect through their published host ports.
KAFKA_BROKER=localhost:9094
KAFKA_CLIENT_ID=signature-server
KAFKA_CONSUMER_GROUP_ID=signature-server-consumer
# Host port for the Kafka UI service (kafka-ui) in docker-compose.yml.
KAFKA_UI_PORT=8080

# Seal Service (sello de tiempo RFC 3161 + constancia NOM-151)
# Microservicio aparte de este repo (carpeta seal-service/). Se invoca al completarse la firma
# avanzada de un documento: se le manda el arreglo de firmas + el documentId y su respuesta se
# guarda en la tabla document_seals (ver SealApiService / SealDocumentUseCase).
# SEAL_SERVICE_API_KEY viaja en el header x-api-key y debe ser IDÉNTICA a la variable API_KEY del
# .env de seal-service — su ApiGuard global rechaza con 401 cualquier petición que no coincida.
# Si cualquiera de las dos falta, el sellado falla con un error explícito y queda logueado, pero
# ni el arranque del servidor ni la firma del documento se ven afectados.
# El puerto debe coincidir con el PORT del .env de seal-service: su default en código es 3001, que
# en local ya lo ocupa signature-app (next dev --port 3001), así que conviene fijarlo en ambos.
SEAL_SERVICE_URL=http://localhost:3002
SEAL_SERVICE_API_KEY=replace-with-the-seal-service-api-key

# Stripe (test mode / sandbox)
# Secret or restricted key from the Stripe dashboard (Developers > API keys,
# Test mode). A restricted key needs write access to Checkout Sessions,
# Customers and Subscriptions, plus read access to Invoices.
STRIPE_SECRET_KEY=sk_test_replace_me
# Firma de los webhooks. La entrega la recibe el modulo `webhooks` (WebhooksModule) en
# POST /api/v1/webhooks/stripe. Dos formas de obtener el secret segun como pruebes:
#   - Stripe CLI: stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
#   - ngrok:      ngrok http 3000, registra
#                 https://<subdominio>.ngrok-free.app/api/v1/webhooks/stripe como endpoint en
#                 el panel de Stripe y copia SU signing secret, que es distinto al que imprime
#                 `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_listen_output
# Ya NO se configuran price_id por variable de entorno: el catalogo de servicios se lee en vivo
# de la API de Stripe (productos y precios activos), asi que dar de alta un servicio o cambiarle
# el precio se hace en el panel del proveedor y se refleja solo, sin desplegar.
# Ver GetPaymentServicesUseCase en src/payments/applications.

# Didit (verificación de identidad con INE + selfie/liveness)
# API key de la aplicación en el panel de Didit (Settings > API Keys). Viaja en el header
# `x-api-key` al crear la sesión y NUNCA sale del servidor: el frontend sólo recibe la URL
# hospedada que devuelve Didit.
DIDIT_API_KEY=replace-with-the-didit-api-key
# Workflow de verificación ya configurado en el panel (qué documentos y qué checks se piden).
# Es lo que determina que se capture INE frente/reverso y se haga face match con la selfie.
DIDIT_WORKFLOW_ID=replace-with-the-didit-workflow-id
# Base de la API de Didit. Sólo se cambia para apuntar a un entorno distinto del productivo.
DIDIT_API_URL=https://verification.didit.me

# Cloudflare Turnstile (CAPTCHA de /signup)
# Clave PRIVADA del widget: solo vive aquí, nunca se manda al frontend ni aparece en logs o
# respuestas. Con ella se canjea contra Siteverify el token que genera el widget antes de crear
# el pre-registro (ver TurnstileService / historia "Implementar Cloudflare Turnstile en el
# registro de usuarios"). Su pareja pública, TURNSTILE_SITE_KEY, va en el .env del frontend.
# Si falta, el registro se rechaza en vez de dejarse pasar (falla cerrado): para desarrollo,
# Cloudflare publica claves de prueba que siempre aprueban —
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# secret de prueba "siempre pasa": 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
