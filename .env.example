# Database Configuration
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME provision the postgres container
# in docker-compose.yml (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB). The app
# itself does NOT read these individually — it reads POSTGRES_DB_URL below.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=signature_db
# docker-compose.yml maps the postgres container to host port 5434 (see
# "ports: 5434:5432" on the postgres service) — use that host port here when
# running the app on the host against the dockerized database.
POSTGRES_DB_URL=postgresql://postgres:postgres@localhost:5434/signature_db

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL for password reset links / CORS origin
FRONTEND_URL=http://localhost:3001

# Mongo
# MONGO_USERNAME/MONGO_PASSWORD/MONGO_DB_NAME provision the mongo container in
# docker-compose.yml. The app reads the full connection string MONGO_DB_URL.
MONGO_USERNAME=admin
MONGO_PASSWORD=admin_password
MONGO_DB_NAME=mongo_db
# docker-compose.yml maps the mongo container to host port 27018 (see
# "ports: 27018:27017" on the mongo service).
MONGO_DB_URL=mongodb://admin:admin_password@localhost:27018/mongo_db?authSource=admin

# Minio Conection Configuration
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY are the credentials the app authenticates
# to MinIO with — they must match MINIO_ROOT_USER/MINIO_ROOT_PASSWORD below
# (or a non-root access key you create in the MinIO console), otherwise every
# file operation (document/signature uploads) fails with an auth error even
# though the container itself starts fine.
MINIO_HOST=localhost
MINIO_PORT=9010
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio_pass
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_pass

MINIO_CREATED_DOCUMENTS_BUCKET=created-documents
MINIO_SIGNED_DOCUMENTS_BUCKET=signed-documents
MINIO_CANCELLED_DOCUMENTS_BUCKET=cancelled-documents
MINIO_REJECTED_DOCUMENTS_BUCKET=rejected-documents
MINIO_OFICIAL_CARDS_BUCKET=oficial-id-cards
MINIO_SIGNATURE_IMAGES_BUCKET=signature-images


CIPHER_SECRET='tu-clave-de-cifrado-reversible'
SENGRID_API_KEY = 'sengrid-api-key'

# JWT auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h

# Redis
# Required by docker-compose.yml (redis service's port mapping and
# --requirepass) — without these two, `docker compose up redis` fails.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-redis-password